---
import { projectCoverUrl } from '../lib/imageUrl'
import type { Project } from '../types/sanity'

interface Props {
  projects?: Project[]
}

const { projects = [] } = Astro.props

function getProjectSlug(project: Project): string {
  if (project.slug?.current) return project.slug.current
  if (project.title) {
    return project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
  }
  return project._id
}
---

<section class="sports-section" id="sports-work" aria-label="Sports & Football Projects">
  <!-- Dynamic Background Name Watermark: Pure internal gradient every 5s, NO white lumiere/glow -->
  <div class="sports-watermark-wrap" aria-hidden="true">
    <span class="sports-watermark">AHMED ESSEKET</span>
  </div>

  <div class="sports-container">
    <!-- Header -->
    <div class="sports-header">
      <div class="sports-header__badge">
        <span class="sports-header__line"></span>
        <span class="section-label">SELECTED WORK</span>
        <span class="sports-header__line"></span>
      </div>
      <h1 class="sports-header__title">
        MY LATEST PROJECTS
      </h1>
    </div>

    <!-- CMS-Driven 3-Column Grid -->
    {projects.length > 0 ? (
      <div class="sports-grid">
        {projects.map((project, i) => {
          const coverUrl = project.coverImage ? projectCoverUrl(project.coverImage, 800, 1000) : ''
          const slug = getProjectSlug(project)
          const projectUrl = `/projects/${slug}`

          return (
            <article class="sports-card">
              <a
                href={projectUrl}
                class="sports-card__link"
                aria-label={`View project: ${project.title}`}
              >
                <!-- 4:5 Poster Image (Sanity hotspot cropped) -->
                <div class="sports-card__image-wrap">
                  {coverUrl ? (
                    <img
                      src={coverUrl}
                      alt={project.title}
                      loading={i < 6 ? 'eager' : 'lazy'}
                      draggable="false"
                    />
                  ) : (
                    <div class="sports-card__placeholder">
                      <span>No image</span>
                    </div>
                  )}
                </div>

                <!-- White Title Strip -->
                <div class="sports-card__title-bar">
                  <h2 class="sports-card__title" title={project.title}>
                    {project.title}
                  </h2>
                </div>

                <!-- Royal Blue Action Button Strip -->
                <div class="sports-card__cta-btn">
                  <span>Discover the project</span>
                  <span class="sports-card__arrow">↗</span>
                </div>
              </a>
            </article>
          )
        })}
      </div>
    ) : (
      <div class="sports-empty">
        <p class="sports-empty__message">There is no work published at the moment.</p>
      </div>
    )}
  </div>
</section>

<style>
  .sports-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding: 7rem 1.5rem 5rem;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* ─── Top Background Watermark: Pure internal gradient every 5s (NO white lumiere/glow) ─── */
  .sports-watermark-wrap {
    position: absolute;
    top: 3.5rem;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    overflow: hidden;
  }

  .sports-watermark {
    font-family: 'Pr_1', sans-serif;
    font-size: clamp(3.5rem, 13vw, 11rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    white-space: nowrap;
    line-height: 0.9;
    user-select: none;
    pointer-events: none;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    /* STRICTLY INTERNAL GRADIENT — NO drop-shadow, NO filter, NO white background bloom */
    background-image: linear-gradient(
      115deg,
      #0e0e10 0%,
      #0e0e10 38%,
      #313960 44%,
      #c1c2d6 49%,
      #b688e7 53%,
      #9ec3f2 57%,
      #F0F0FF 61%,
      #3B82F6 65%,
      #0e0e10 72%,
      #0e0e10 100%
    );
    background-size: 320% 100%;
    background-position: 160% 0;
    animation: internalGradientSweep 5s ease-in-out infinite;
    opacity: 0.9;
    will-change: background-position;
  }

  @keyframes internalGradientSweep {
    0% {
      background-position: 160% 0;
    }
    35% {
      background-position: -160% 0;
    }
    100% {
      background-position: -160% 0;
    }
  }

  .sports-container {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
  }

  .sports-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .sports-header__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 600px;
  }

  .sports-header__line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
  }

  .sports-header__title {
    font-family: 'Pr_1', sans-serif;
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    line-height: 1.05;
  }

  /* ─── 3-Column Cards Grid ─── */
  .sports-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem 1.5rem;
  }

  .sports-card {
    background: #000000;
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.35s ease,
                border-color 0.35s ease;
  }

  .sports-card:hover {
    transform: translateY(-6px);
    border-color: #FFFFFF;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.8),
                0 0 24px rgba(29, 99, 237, 0.3);
  }

  .sports-card__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  /* Strict 4:5 Poster Image container with crop */
  .sports-card__image-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #0d0d0d;
    position: relative;
  }

  .sports-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sports-card:hover .sports-card__image-wrap img {
    transform: scale(1.04);
  }

  .sports-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: 0.8rem;
    font-family: 'Pr_2', sans-serif;
  }

  /* Solid White Title Strip */
  .sports-card__title-bar {
    background: #FFFFFF;
    padding: 0.75rem 0.6rem;
    text-align: center;
    border-top: 1.5px solid rgba(255, 255, 255, 0.9);
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.9);
  }

  .sports-card__title {
    color: #000000;
    font-family: 'Pr_1', sans-serif;
    font-size: clamp(0.72rem, 0.88vw, 0.84rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.25;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  /* Vibrant Royal Blue Action Button Strip */
  .sports-card__cta-btn {
    background: #1D63ED;
    color: #FFFFFF;
    font-family: 'Pr_2', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 0.65rem 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    transition: background 0.25s ease, filter 0.25s ease;
  }

  .sports-card__arrow {
    font-size: 0.85rem;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .sports-card:hover .sports-card__cta-btn {
    background: #256BF5;
    filter: brightness(1.1);
  }

  .sports-card:hover .sports-card__arrow {
    transform: translate(2px, -2px);
  }

  /* ─── Empty State ─── */
  .sports-empty {
    padding: 6rem 2rem;
    text-align: center;
    max-width: 500px;
    margin: 2rem auto;
  }

  .sports-empty__message {
    font-family: 'Pr_2', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .sports-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .sports-section {
      padding: 6rem 1.25rem 4rem;
    }
  }

  @media (max-width: 640px) {
    .sports-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .sports-header__title {
      font-size: 2rem;
    }

    .sports-watermark {
      font-size: 4rem;
    }
  }
</style>
