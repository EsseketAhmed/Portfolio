---
import BaseLayout     from '../../layouts/BaseLayout.astro'
import Navbar          from '../../components/Navbar.astro'
import Footer          from '../../components/Footer.astro'
import SportsGrid      from '../../components/SportsGrid.astro'
import ContactSection  from '../../components/ContactSection.astro'

import { sanityClient } from '../../lib/sanity'
import { SPORTS_PROJECTS_QUERY, SITE_SETTINGS_QUERY, HOME_PAGE_QUERY } from '../../lib/queries'
import type { Project, SiteSettings, HomePage } from '../../types/sanity'

let sportsProjects: Project[] = []
let settings: SiteSettings | null = null
let homePage: HomePage | null = null

try {
  ;[sportsProjects, settings, homePage] = await Promise.all([
    sanityClient.fetch<Project[]>(SPORTS_PROJECTS_QUERY),
    sanityClient.fetch<SiteSettings>(SITE_SETTINGS_QUERY),
    sanityClient.fetch<HomePage>(HOME_PAGE_QUERY),
  ])
} catch {
  // Graceful fallback when Sanity is offline / not connected yet
}
---

<BaseLayout
  title="Sports Projects — Ahmed Esseket"
  description="Explore the sports, football, and athletic visual storytelling work of Ahmed Esseket — key visuals, gamedays, and campaigns."
>
  <Navbar />

  <main id="main-content">
    <SportsGrid projects={sportsProjects} />

    <ContactSection
      title={homePage?.contactTitle}
      text={homePage?.contactText}
      email={homePage?.email ?? settings?.email}
      socialLinks={homePage?.socialLinks ?? settings?.socialLinks ?? []}
    />
  </main>

  <Footer
    email={settings?.email}
    socialLinks={settings?.socialLinks ?? []}
    footerText={settings?.footerText}
  />
</BaseLayout>
