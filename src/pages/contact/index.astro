---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import { sanityClient } from '../../lib/sanity'
import { HOME_PAGE_QUERY, SITE_SETTINGS_QUERY } from '../../lib/queries'
import type { HomePage, SiteSettings } from '../../types/sanity'

let homePage: HomePage | null = null
let settings: SiteSettings | null = null

try {
  ;[homePage, settings] = await Promise.all([
    sanityClient.fetch<HomePage>(HOME_PAGE_QUERY),
    sanityClient.fetch<SiteSettings>(SITE_SETTINGS_QUERY),
  ])
} catch {
  // Keep the contact page usable while Sanity is not connected.
}

const email = homePage?.email ?? settings?.email ?? 'hello@ahmedesseket.com'
const socialLinks = homePage?.socialLinks ?? settings?.socialLinks ?? []
---

<BaseLayout
  title="Contact Ahmed Esseket — Start a Project"
  description="Tell Ahmed Esseket about your project, campaign or visual identity. Get in touch to discuss a collaboration."
>
  <Navbar />

  <main class="contact-page" id="main-content">
    <header class="contact-page__header">
      <span class="section-label">Get in touch</span>
      <h1 class="contact-page__title">
        HAVE A PROJECT<br />
        <span class="gradient-text">IN MIND?</span>
      </h1>
      <p class="contact-page__intro">
        Share a few details and I’ll get back to you to talk through your ideas,
        goals and next steps.
      </p>
    </header>

    <div class="contact-page__content">
      <form
        id="contact-form"
        class="contact-form"
        action={`mailto:${email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="contact-form__field">
            <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
            <input id="contact-email" name="replyEmail" type="email" autocomplete="email" required />
          </div>
        </div>

        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for="contact-project">What do you need?</label>
            <select id="contact-project" name="projectType">
              <option value="">Choose a project type</option>
              <option>Sports graphics or campaign</option>
              <option>Brand identity</option>
              <option>Art direction</option>
              <option>Something else</option>
            </select>
          </div>
          <div class="contact-form__field">
            <label for="contact-budget">Estimated budget <span class="contact-form__optional">(optional)</span></label>
            <select id="contact-budget" name="budget">
              <option value="">Choose a range</option>
              <option>Under €1,000</option>
              <option>€1,000–€3,000</option>
              <option>€3,000–€5,000</option>
              <option>€5,000+</option>
              <option>Let’s discuss</option>
            </select>
          </div>
        </div>

        <div class="contact-form__field">
          <label for="contact-message">Tell me about your project <span aria-hidden="true">*</span></label>
          <textarea
            id="contact-message"
            name="message"
            rows="6"
            placeholder="What are you looking to create?"
            required
          ></textarea>
        </div>

        <button class="btn-primary contact-form__submit" type="submit">
          Send your enquiry <span aria-hidden="true">↗</span>
        </button>
        <p class="contact-form__note" aria-live="polite">
          Your email app will open with your enquiry ready to send.
        </p>
      </form>

      <aside class="contact-details" aria-label="Other ways to get in touch">
        <div class="contact-details__block">
          <span class="section-label">Prefer email?</span>
          <a class="contact-details__email" href={`mailto:${email}`}>{email}</a>
        </div>

        <div class="contact-details__rule" aria-hidden="true"></div>

        <div class="contact-details__block">
          <span class="section-label">A good first message</span>
          <p>
            A little about your project, what you’re hoping to achieve, and any
            timing you have in mind is a great place to start.
          </p>
        </div>

        {socialLinks.length > 0 && (
          <>
            <div class="contact-details__rule" aria-hidden="true"></div>
            <div class="contact-details__block">
              <span class="section-label">Find me online</span>
              <div class="contact-details__socials">
                {socialLinks.map(link => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.handle ?? link.platform} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </>
        )}
      </aside>
    </div>
  </main>

  <Footer
    email={email}
    socialLinks={socialLinks}
    footerText={homePage?.footerText ?? settings?.footerText}
  />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')

  if (!form) throw new Error('Contact form element not found')

  form.addEventListener('submit', event => {
    event.preventDefault()

    const formData = new FormData(form)
    const subject = `Project enquiry from ${String(formData.get('name') ?? '')}`
    const body = [
      `Name: ${formData.get('name') ?? ''}`,
      `Email: ${formData.get('replyEmail') ?? ''}`,
      `Project type: ${formData.get('projectType') || 'Not specified'}`,
      `Estimated budget: ${formData.get('budget') || 'Not specified'}`,
      '',
      'Project details:',
      String(formData.get('message') ?? ''),
    ].join('\n')

    const recipient = form.getAttribute('action')?.replace(/^mailto:/, '')
    if (!recipient) throw new Error('Contact email address is missing')

    window.location.href = `mailto:${recipient}?${new URLSearchParams({ subject, body }).toString()}`
  })
</script>

<style>
  .contact-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 10rem 2.5rem 7rem;
  }

  .contact-page__header {
    max-width: 760px;
    margin-bottom: 4rem;
  }

  .contact-page__header .section-label {
    display: block;
    margin-bottom: 1rem;
  }

  .contact-page__title {
    font-family: 'Pr_1', sans-serif;
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
  }

  .contact-page__intro {
    max-width: 540px;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .contact-page__content {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(240px, 0.8fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .contact-form__field label {
    color: var(--color-text);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .contact-form__field label span:not(.contact-form__optional) {
    color: var(--color-lavender);
  }

  .contact-form__optional {
    color: var(--color-muted);
  }

  .contact-form__field input,
  .contact-form__field select,
  .contact-form__field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid #292929;
    border-radius: 2px;
    outline: none;
    background: #101010;
    color: var(--color-text);
    font: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .contact-form__field textarea {
    min-height: 10rem;
    resize: vertical;
  }

  .contact-form__field input::placeholder,
  .contact-form__field textarea::placeholder {
    color: #777;
  }

  .contact-form__field input:focus,
  .contact-form__field select:focus,
  .contact-form__field textarea:focus {
    border-color: var(--color-lavender);
    box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.12);
  }

  .contact-form__submit {
    align-self: flex-start;
    min-height: 3rem;
    border: 0;
    cursor: pointer;
  }

  .contact-form__note {
    margin-top: -1rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    background: linear-gradient(145deg, #121212, #0d0d0d);
  }

  .contact-details__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .contact-details__email {
    color: var(--color-text);
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .contact-details__email:hover,
  .contact-details__socials a:hover {
    color: var(--color-lavender);
  }

  .contact-details__block p {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .contact-details__rule {
    width: 100%;
    height: 1px;
    background: var(--color-border);
  }

  .contact-details__socials {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-details__socials a {
    color: var(--color-text);
    font-size: 0.875rem;
    transition: color 0.2s ease;
  }

  @media (max-width: 760px) {
    .contact-page {
      padding: 8rem 1.25rem 5rem;
    }

    .contact-page__header {
      margin-bottom: 3rem;
    }

    .contact-page__content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 520px) {
    .contact-form__row {
      grid-template-columns: 1fr;
    }

    .contact-form__submit {
      width: 100%;
      justify-content: center;
    }
  }
</style>
